# Temporary directories
TutorSaas_tmp/


# Secretos locales (IA-01) � copiar config.sample.json a config.json y NO commitear
config.json
*.key
.env

# Salida generada de herramientas de análisis (no es código fuente)
graphify-out/

# Artefactos locales del agente / análisis
analyze_out.txt

# Supabase CLI local (.temp de link/start)
supabase/.temp/
supabase/**/.temp/
supabase/functions/**/.temp/

# Dependencias de herramientas locales de opencode
.opencode/node_modules/

# Credenciales de service account de Google Play (NUNCA versionar)
secrets/

# Firma de release Android (NUNCA versionar: contiene private keys)
**/key.properties
**/*.jks
**/*.keystore

untranslated.json

# Report de Gradle que se regenera en cada build (estaba versionado por error)
android/build/reports/problems/problems-report.html
# Evidencia local de issues
evidencia_*.png
# Certificado publico de subida (se deriva del keystore; el SHA-1 se documenta en docs/)
android/app/upload_certificate.pem
