<?xml version="1.0" encoding="utf-8"?>
<!-- P-36 (#121): widget de inicio. Solo oscuro, coherente con la paleta:
     voidBg #05070E, manaCyan #00E5FF, royalGold #FFC700. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:letterSpacing="0.12"
        android:text="@string/widget_brand"
        android:textColor="#FF9CF0FF"
        android:textSize="9sp"
        android:textStyle="bold" />

    <!-- Estado con datos: racha + minutos de hoy vs meta. Arranca oculto
         para que ni el preview del launcher ni el primer frame muestren ceros
         falsos; el provider lo hace visible cuando hay datos frescos. -->
    <LinearLayout
        android:id="@+id/widget_data"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_streak_days"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="#FFFFC700"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_streak_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:letterSpacing="0.08"
                android:text="@string/widget_streak_label"
                android:textColor="#FFBAC9CC"
                android:textSize="8sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_minutes_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:letterSpacing="0.08"
                android:text="@string/widget_minutes_label"
                android:textColor="#FFBAC9CC"
                android:textSize="8sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_minutes_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="#FF00E5FF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Estado vacío honesto: ni ceros ni datos de ayer. Visible por defecto
         hasta que el provider tenga una foto fresca. -->
    <LinearLayout
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_empty_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:text="@string/widget_empty_title"
            android:textColor="#FFE6E9F2"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_empty_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="@string/widget_empty_body"
            android:textColor="#FFBAC9CC"
            android:textSize="11sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/widget_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="10dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/widget_progress"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_practice"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/widget_button"
        android:gravity="center"
        android:letterSpacing="0.08"
        android:maxLines="1"
        android:text="@string/widget_practice"
        android:textColor="#FF05070E"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
