{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "permission": {
    "bash": {
      "*": "ask",
      "git status": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "flutter analyze*": "allow",
      "flutter test*": "allow"
    }
  },
  "tool_output": { "max_lines": 150, "max_bytes": 8192 },
  "compaction": { "auto": true, "tail_turns": 15 },
  "mcp": {
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp?read_only=true",
      "enabled": true
    }
  },
  "provider": {
    "deepseek": {
      "models": {
        "deepseek-v4-flash": {
          "limit": {
            "context": 1000000,
            "output": 4096
          }
        }
      }
    }
  }
}
